# Copy to .env.local and restart the dev server to apply.

# Show the "Improve with AI" button on comments (each user pastes their own
# Anthropic API key in Settings). Off unless set to true.
VITE_ENABLE_AI=false

# Google AdSense. Ads, the cookie banner and "Privacy choices" stay off until
# both are set. On Vercel, add them under Project Settings > Environment Variables.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=
# "builtin" = this app's cookie banner; "google" = AdSense's certified
# Privacy & messaging consent (needed for personalized ads in the EEA/UK/CH).
VITE_ADS_CONSENT_MODE=builtin

# Shown in the Terms, Privacy Policy and other legal pages.
VITE_LEGAL_OPERATOR=BALISOFT
VITE_LEGAL_CONTACT_EMAIL=
# e.g. "Spain" or "the State of Florida, USA"
VITE_LEGAL_GOVERNING_LAW=
